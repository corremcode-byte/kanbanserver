# Server Configuration
PORT=4001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/asana-clone

# Frontend URL
ALLOWED_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

# Task description/comment field encryption — optional.
# Falls back to JWT_SECRET if unset, so this only needs to be set if you want a
# dedicated secret separate from the auth signing key.
# TASK_FIELD_ENCRYPTION_SECRET=your-dedicated-secret

# Used to encrypt sensitive fields at rest (User.plainPassword/passkey, and
# RemoteServer RDP/SSH/VNC credentials — see Remote Server Workspace below).
# Falls back to an insecure default if unset — set a real value in production.
ENCRYPTION_KEY=your-32-byte-secret-change-this

# Remote Server Workspace (Apache Guacamole integration)
# Guacamole/guacd already run independently of this app — these vars only tell
# the backend how to reach Guacamole's REST API using a dedicated service
# account. Individual remote servers (hostname, port, credentials) are managed
# through the app's own admin API and stored in MongoDB, not here.
GUACAMOLE_URL=http://localhost:8080/guacamole
GUACAMOLE_USERNAME=guacadmin
GUACAMOLE_PASSWORD=change-me
GUACAMOLE_DATASOURCE=mysql
GUACAMOLE_TIMEOUT=8000
LOG_CONNECTIONS=true

# Public URL of the Guacamole subdomain the BROWSER is redirected to when a
# user clicks Connect (nginx-fronted, outside this app — see
# docs/nginx-guac-redirect.conf.example). Falls back to GUACAMOLE_URL if
# unset; only set this separately if the backend reaches Guacamole via a
# different address than the browser does.
# GUACAMOLE_PUBLIC_URL=https://guac.example.com

# Shared secret nginx sends on every auth_request call to
# /api/remote-workspace/redirect/entry and /redirect/check, so those two
# public (non-JWT) endpoints can trust the caller is nginx and not a random
# internet client. Must match the value configured in the nginx example
# config. Required for the Connect redirect flow to work at all.
NGINX_INTERNAL_SECRET=change-me-to-a-long-random-value

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY=your-private-key

# ===================================
# EMAIL CONFIGURATION - Choose ONE option below
# ===================================

# OPTION 1: Gmail (Free, 500 emails/day)
# Requires: 2FA enabled + App Password
# Setup: https://myaccount.google.com/apppasswords
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-16-char-app-password
# EMAIL_FROM=your-email@gmail.com

# OPTION 2: Outlook/Hotmail (Free, Limited daily sending)
# Works with: @outlook.com, @hotmail.com, @live.com
# For personal accounts: Use regular password (no 2FA needed)
# For Microsoft 365: May need admin to enable SMTP AUTH
EMAIL_HOST=smtp-mail.outlook.com
EMAIL_PORT=587
EMAIL_USER=your-email@outlook.com
EMAIL_PASS=your-outlook-password
EMAIL_FROM=your-email@outlook.com

# OPTION 3: Microsoft 365 Business
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@yourdomain.com
# EMAIL_PASS=your-password
# EMAIL_FROM=your-email@yourdomain.com

# OPTION 4: Mailtrap (Development/Testing - emails don't send to real addresses)
# Get free account at https://mailtrap.io
# Perfect for testing without spamming real users
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USER=your-mailtrap-username
# EMAIL_PASS=your-mailtrap-password
# EMAIL_FROM=test@example.com

# OPTION 5: Custom SMTP (SendGrid, Mailgun, Brevo, etc.)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=your-username
# EMAIL_PASS=your-password
# EMAIL_FROM=noreply@example.com
